generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String
  release   String
  status    String      @default("NEW")
  createdAt DateTime    @default(now())
  audits    LeadAudit[]
}

model LeadAudit {
  id        String   @id @default(cuid())
  leadId    String
  oldStatus String
  newStatus String
  changedAt DateTime @default(now())
  Lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Cliente {
  id                  String               @id @default(cuid())
  nome                String
  email               String               @unique
  senhaHash           String
  sessionVersion      Int                  @default(0)
  telefone            String?
  tipoPessoa          String?
  documento           String?
  razaoSocial         String?
  nomeFantasia        String?
  nomeContato         String?
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  observacoes         String?
  ativo               Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  faturas             Fatura[]
  tickets             Ticket[]
  passwordResetTokens PasswordResetToken[]
}

model Fatura {
  id              String    @id @default(cuid())
  clienteId       String
  cliente         Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  descricao       String
  valor           Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDENTE")
  vencimento      DateTime
  pagoEm          DateTime?
  stripePaymentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clienteId])
}

model Ticket {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  protocolo  String @unique
  tipo       String @default("SUPORTE")
  titulo     String
  descricao  String
  prioridade String @default("NORMAL")
  status     String @default("ABERTO")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  encerradoEm DateTime?

  mensagens TicketMensagem[]

  @@index([clienteId])
  @@index([status])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  sucesso   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  clienteId String
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clienteId])
  @@index([expiresAt])
}

model TicketMensagem {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  autorTipo String
  mensagem  String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model Post {
  id       String @id @default(cuid())
  titulo   String
  slug     String @unique
  resumo   String
  conteudo String @db.Text

  categoria      String
  leituraMinutos Int?
  imagemCapa     String?

  status   String  @default("RASCUNHO")
  destaque Boolean @default(false)

  regioes  String[] @default([])
  servicos String[] @default([])

  seoTitle       String?
  seoDescription String?
  canonical      String?

  ctaTexto String?
  ctaUrl   String?

  publicadoEm  DateTime?
  agendadoPara DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publicadoEm])
  @@index([categoria])
  @@index([destaque])
}

enum UsuarioPapel {
  SUPER_ADMIN
  ADMIN
  COMERCIAL
  FINANCEIRO
  SUPORTE
  CONTEUDO
}

model Usuario {
  id                  String                      @id @default(cuid())
  nome                String
  email               String                      @unique
  senhaHash           String
  papel               UsuarioPapel
  ativo               Boolean                     @default(true)
  sessionVersion      Int                         @default(0)
  ultimoLoginEm       DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  passwordResetTokens UsuarioPasswordResetToken[]

  @@index([papel])
  @@index([ativo])
  @@index([createdAt])
}

model UsuarioPasswordResetToken {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

model UsuarioLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  sucesso   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

model LeadEmailRecipient {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
  @@index([createdAt])
}

// ============================================================
// STR ACADEMY
// MODELOS ACADEMICOS
// ============================================================

enum AcademyNivel {
  APRENDIZ
  JUNIOR
  OPERACIONAL
}

enum AcademyMatriculaStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

model AcademyAluno {
  id                      String                          @id @default(cuid())
  nome                    String
  email                   String                          @unique
  senhaHash               String
  ativo                   Boolean                         @default(true)
  emailVerificadoEm       DateTime?
  sessionVersion          Int                             @default(0)
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  matriculas              AcademyMatricula[]
  progressos              AcademyProgressoAula[]
  loginAttempts           AcademyLoginAttempt[]
  passwordResetTokens     AcademyPasswordResetToken[]
  emailVerificationTokens AcademyEmailVerificationToken[]
}

model AcademyTrilha {
  id         String             @id @default(cuid())
  titulo     String
  slug       String             @unique
  descricao  String?
  nivel      AcademyNivel
  ativo      Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  modulos    AcademyModulo[]
  matriculas AcademyMatricula[]
}

model AcademyModulo {
  id        String        @id @default(cuid())
  trilhaId  String
  titulo    String
  ordem     Int
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  trilha    AcademyTrilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  aulas     AcademyAula[]

  @@unique([trilhaId, ordem])
  @@index([trilhaId])
}

model AcademyAula {
  id         String                 @id @default(cuid())
  moduloId   String
  titulo     String
  slug       String
  conteudo   String
  ordem      Int
  ativo      Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  modulo     AcademyModulo          @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  progressos AcademyProgressoAula[]

  @@unique([moduloId, slug])
  @@unique([moduloId, ordem])
  @@index([moduloId])
}

model AcademyMatricula {
  id            String                 @id @default(cuid())
  alunoId       String
  trilhaId      String
  status        AcademyMatriculaStatus @default(ATIVA)
  matriculadoEm DateTime               @default(now())
  concluidaEm   DateTime?
  aluno         AcademyAluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  trilha        AcademyTrilha          @relation(fields: [trilhaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, trilhaId])
  @@index([alunoId])
  @@index([trilhaId])
}

model AcademyProgressoAula {
  id          String       @id @default(cuid())
  alunoId     String
  aulaId      String
  concluida   Boolean      @default(false)
  concluidaEm DateTime?
  updatedAt   DateTime     @updatedAt
  aluno       AcademyAluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula        AcademyAula  @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, aulaId])
  @@index([alunoId])
  @@index([aulaId])
}

model AcademyLoginAttempt {
  id        String        @id @default(cuid())
  alunoId   String?
  email     String
  sucesso   Boolean
  ip        String?
  createdAt DateTime      @default(now())
  aluno     AcademyAluno? @relation(fields: [alunoId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([alunoId])
}

model AcademyPasswordResetToken {
  id        String       @id @default(cuid())
  alunoId   String
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  aluno     AcademyAluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([expiresAt])
}

model AcademyEmailVerificationToken {
  id        String       @id @default(cuid())
  alunoId   String
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  aluno     AcademyAluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([expiresAt])
}

model AcademyCadastroAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  sucesso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
