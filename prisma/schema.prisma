generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String
  release   String
  status    String      @default("NEW")
  createdAt DateTime    @default(now())
  audits    LeadAudit[]
}

model LeadAudit {
  id        String   @id @default(cuid())
  leadId    String
  oldStatus String
  newStatus String
  changedAt DateTime @default(now())
  Lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Cliente {
  id                  String               @id @default(cuid())
  nome                String
  email               String               @unique
  senhaHash           String
  sessionVersion      Int                  @default(0)
  telefone            String?
  tipoPessoa           String?
  documento            String?
  razaoSocial          String?
  nomeFantasia         String?
  nomeContato          String?
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String?
  observacoes          String?
  ativo                Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  faturas             Fatura[]
  tickets             Ticket[]
  passwordResetTokens PasswordResetToken[]
}

model Fatura {
  id              String    @id @default(cuid())
  clienteId       String
  cliente         Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  descricao       String
  valor           Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDENTE")
  vencimento      DateTime
  pagoEm          DateTime?
  stripePaymentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clienteId])
}

model Ticket {
  id           String    @id @default(cuid())
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  protocolo    String    @unique
  tipo          String    @default("SUPORTE")
  titulo        String
  descricao    String
  prioridade   String    @default("NORMAL")
  status        String    @default("ABERTO")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  encerradoEm   DateTime?

  mensagens     TicketMensagem[]

  @@index([clienteId])
  @@index([status])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  sucesso   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  clienteId String
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clienteId])
  @@index([expiresAt])
}
model TicketMensagem {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  autorTipo String
  mensagem  String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}